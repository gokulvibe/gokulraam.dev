---
// System Design Handbook — long-form, static reading page.
// Prerendered (no editables). Mermaid diagrams render client-side and
// re-render on theme toggle so they match Nocturnal / Daylight.
import Base from '@/layouts/Base.astro';

const lessons = [
  { id: 'lesson-1', n: '01', title: 'Top K Elements', sub: 'the heavy hitters' },
  { id: 'lesson-2', n: '02', title: 'Time-Based Ranking', sub: 'sliding windows' },
  { id: 'lesson-3', n: '03', title: 'Frequency Counting', sub: 'the viral event' },
  { id: 'lesson-4', n: '04', title: 'Global Leaderboards', sub: 'complex ranking' },
  { id: 'lesson-5', n: '05', title: 'Caching & Eviction', sub: 'LRU vs. LFU' },
  { id: 'lesson-6', n: '06', title: 'Search Autocomplete', sub: 'the trie' },
  { id: 'lesson-7', n: '07', title: 'Merging Sorted Streams', sub: 'news feeds' },
  { id: 'lesson-8', n: '08', title: 'Geospatial Search', sub: 'location tracking' },
  { id: 'lesson-9', n: '09', title: 'Approximate Counting', sub: 'breaking memory limits' },
];

const likeFlow = `flowchart TD
  A[User Clicks Like] --> B[API Gateway]
  B -->|Fast Path O-1| C[(Redis: Cached Total)]
  B -->|Source of Truth| D[Kafka Topic]
  D --> E[Consumer Workers]
  E -->|Micro-Batch 10k items| F[PgBouncer Pooler]
  F -->|COPY Command| G[(PostgreSQL Primary)]`;

const trieFlow = `graph TD
  R[Root] --> S[s]
  S --> Y[y]
  Y --> S2["s <br/> <i>top_10_cache: system design, system of a down, systolic…</i>"]
  S2 --> T[t]
  S2 --> E[e]`;

const likeEvent = '{user_id, video_id, timestamp, action="like"}';
---

<Base
  title="System Design Handbook — Gokul Raam"
  description="A narrative handbook bridging algorithmic intuition with high-scale production architecture: Top K, sliding windows, write-behind caches, leaderboards, LRU/LFU, tries, k-way merge, geohashing, Bloom filters and HyperLogLog."
>
  <article class="sd">
    <header class="mb-12">
      <div class="label mb-4">// system design</div>
      <h1 class="display text-5xl md:text-6xl">System Design<br /><span class="italic text-ember">Handbook.</span></h1>
      <p class="sd-lede mt-6">
        Nine problems, each told the same way: the naive approach, the DSA evolution, then what
        production actually runs. Read in order — every lesson patches the previous one's weak spot.
      </p>
    </header>

    <nav class="sd-toc" aria-label="Lessons">
      <div class="label mb-3">// contents</div>
