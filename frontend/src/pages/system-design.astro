<script>
  // Mermaid is ~heavy, so load it only on this page and only when a diagram exists.
  // Theme is derived from the site's CSS tokens and re-rendered on theme toggle.
  const figures = Array.from(document.querySelectorAll<HTMLElement>('.sd-diagram[data-mermaid]'));
  let seq = 0;

  function themeVars() {
    const cs = getComputedStyle(document.documentElement);
    const v = (n: string) => cs.getPropertyValue(n).trim();
    const light = document.documentElement.getAttribute('data-theme') === 'light';
    return {
      darkMode: !light,
      background: 'transparent',
      fontFamily: '"JetBrains Mono", ui-monospace, monospace',
      fontSize: '13px',
      primaryColor: v('--c-surface'),
      primaryBorderColor: v('--c-accent'),
      primaryTextColor: v('--c-text'),
      secondaryColor: v('--c-bg-2'),
      tertiaryColor: v('--c-bg-2'),
      lineColor: v('--c-accent-2'),
      textColor: v('--c-text-2'),
      edgeLabelBackground: v('--c-bg'),
      clusterBkg: v('--c-bg-2'),
    };
  }

  async function render() {
    if (!figures.length) return;
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({ startOnLoad: false, theme: 'base', themeVariables: themeVars(), securityLevel: 'strict' });
    for (const fig of figures) {
      const canvas = fig.querySelector<HTMLElement>('.sd-diagram__canvas');
      const src = fig.dataset.mermaid;
      if (!canvas || !src) continue;
      try {
        const { svg } = await mermaid.render(`sd-mmd-${seq++}`, src);
        canvas.innerHTML = svg;
      } catch (err) {
        console.warn('[system-design] mermaid render failed', err);
        canvas.textContent = src;
        canvas.classList.add('sd-diagram__canvas--fallback');
      }
    }
  }

  render();
  new MutationObserver(() => render()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>

